generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
}

enum AvailabilityStatus {
  AVAILABLE
  BLOCKED
  BOOKED
}

enum AvailabilitySource {
  MANUAL
  AIRBNB
}

enum BookingRequestStatus {
  NEW
  CONTACTED
  CONFIRMED
  CANCELLED
}

enum ListingSourceType {
  AIRBNB
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Listing {
  id               String                @id @default(cuid())
  slug             String                @unique
  title            String
  shortDescription String?
  description      String?
  city             String?
  district         String?
  address          String?
  latitude         Float?
  longitude        Float?
  guestCapacity    Int
  bedroomCount     Int?
  bedCount         Int?
  bathroomCount    Int?
  basePrice        Decimal               @db.Decimal(10, 2)
  cleaningFee      Decimal?              @db.Decimal(10, 2)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  images           ListingImage[]
  amenities        ListingAmenityRel[]
  availability     ListingAvailability[]
  sources          ListingSource[]
  bookingRequests  BookingRequest[]
  locationMapUrl     String?
  checkInTime        String?
  checkOutTime       String?
  allowSmoking       Boolean  @default(false)
  allowPets          Boolean  @default(false)
  allowEvents        Boolean  @default(false)
  cancellationPolicy String?
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Amenity {
  id        String               @id @default(cuid())
  name      String               @unique
  icon      String?
  createdAt DateTime             @default(now())

  listings  ListingAmenityRel[]
}

model ListingAmenityRel {
  id        String   @id @default(cuid())
  listingId String
  amenityId String

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([listingId, amenityId])
  @@index([listingId])
  @@index([amenityId])
}

model ListingAvailability {
  id            String             @id @default(cuid())
  listingId     String
  date          DateTime
  status        AvailabilityStatus @default(AVAILABLE)
  source        AvailabilitySource @default(MANUAL)
  priceOverride Decimal?           @db.Decimal(10, 2)
  minNights     Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  listing       Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId, date])
}

model ListingSource {
  id                  String            @id @default(cuid())
  listingId           String
  sourceType          ListingSourceType
  icalUrl             String
  externalListingName String?
  isActive            Boolean           @default(true)
  lastSyncedAt        DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  listing             Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@unique([listingId, sourceType])
}

model BookingRequest {
  id         String               @id @default(cuid())
  listingId  String
  checkIn    DateTime
  checkOut   DateTime
  guestCount Int
  fullName   String
  email      String
  phone      String?
  note       String?
  status     BookingRequestStatus @default(NEW)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  listing    Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([status])
}

model ContactMessage {
  id        String               @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())

  @@index([createdAt])
  @@index([status])
}